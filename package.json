{
  "name": "@workonce/core",
  "version": "0.2.0",
  "description": "Typed durable work, fenced attempts, dynamic retries and adapter conformance",
  "license": "MIT",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/storage.d.ts",
        "default": "./dist/storage.js"
      },
      "require": {
        "types": "./dist-cjs/storage.d.ts",
        "default": "./dist-cjs/storage.js"
      }
    },
    "./memory": {
      "import": {
        "types": "./dist/memory.d.ts",
        "default": "./dist/memory.js"
      },
      "require": {
        "types": "./dist-cjs/memory.d.ts",
        "default": "./dist-cjs/memory.js"
      }
    },
    "./sqlite": {
      "import": {
        "types": "./dist/sqlite.d.ts",
        "default": "./dist/sqlite.js"
      },
      "require": {
        "types": "./dist-cjs/sqlite.d.ts",
        "default": "./dist-cjs/sqlite.js"
      }
    },
    "./kernel": {
      "import": {
        "types": "./dist/kernel.d.ts",
        "default": "./dist/kernel.js"
      },
      "require": {
        "types": "./dist-cjs/kernel.d.ts",
        "default": "./dist-cjs/kernel.js"
      }
    },
    "./conformance": {
      "import": {
        "types": "./dist/conformance.d.ts",
        "default": "./dist/conformance.js"
      },
      "require": {
        "types": "./dist-cjs/conformance.d.ts",
        "default": "./dist-cjs/conformance.js"
      }
    },
    "./cas": {
      "import": {
        "types": "./dist/cas.d.ts",
        "default": "./dist/cas.js"
      },
      "require": {
        "types": "./dist-cjs/cas.d.ts",
        "default": "./dist-cjs/cas.js"
      }
    },
    "./external": {
      "import": {
        "types": "./dist/external.d.ts",
        "default": "./dist/external.js"
      },
      "require": {
        "types": "./dist-cjs/external.d.ts",
        "default": "./dist-cjs/external.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "storage": [
        "dist/storage.d.ts"
      ],
      "memory": [
        "dist/memory.d.ts"
      ],
      "sqlite": [
        "dist/sqlite.d.ts"
      ],
      "kernel": [
        "dist/kernel.d.ts"
      ],
      "conformance": [
        "dist/conformance.d.ts"
      ],
      "cas": [
        "dist/cas.d.ts"
      ],
      "external": [
        "dist/external.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "README.md",
    "LICENSE",
    "docs",
    "formal",
    "assurance"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/cjs-package.mjs && node scripts/build-source-binding.mjs --write",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:process": "node scripts/build-source-binding.mjs && node --test test/process/*.test.mjs",
    "formal": "node scripts/formal.mjs && node scripts/storage-formal.mjs",
    "prepack": "npm run build",
    "prepare": "node scripts/prepare-package.mjs",
    "format:check": "prettier --check src test scripts README.md docs package.json .github/workflows/check.yml",
    "test:consumer": "npm run build && node scripts/consumer-smoke.mjs",
    "bench": "npm run build && node scripts/benchmark.mjs",
    "assurance:manifest": "node scripts/check-formal-implementation-conformance.mjs",
    "assurance:traces": "node scripts/check-bounded-trace-domain.mjs",
    "assurance:update": "npm run build && node scripts/check-formal-implementation-conformance.mjs --write && node scripts/check-bounded-trace-domain.mjs --write",
    "assurance": "node scripts/run-assurance.mjs",
    "assurance:update:ack": "npm run build && node scripts/check-formal-implementation-conformance.mjs --write --ack-source-model-review && node scripts/check-bounded-trace-domain.mjs --write",
    "check:web": "tsc --noEmit -p tsconfig.webworker.json && node scripts/check-web-runtime.mjs",
    "test:web": "npm run build && npm run check:web"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.0",
    "prettier": "3.6.2"
  }
}
